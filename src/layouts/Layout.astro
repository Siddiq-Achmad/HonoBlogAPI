---
import '../style.css';
import { ClientRouter } from 'astro:transitions';
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  activeNav?: 'home' | 'magazine' | 'categories' | 'about';
}

const {
  title = 'LUXIMA MAGAZINE — The Premier Luxury Wedding & Editorial Journal',
  description = 'Jurnal dan majalah pernikahan mewah terkurasi. Mengulas gaun bridal haute couture, destinasi villa bersejarah, instalasi floral megah, dan perhiasan adiluhung.',
  ogImage = 'https://images.unsplash.com/photo-1519741497674-611481863552?w=1600',
  activeNav = 'home'
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, 'https://blog.luxima.id').href;

// Global Organization & Website JSON-LD Structured Data for SEO / AEO / GEO
const globalSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://blog.luxima.id/#organization",
      "name": "LUXIMA Atelier & Editorial",
      "url": "https://blog.luxima.id",
      "logo": "https://images.unsplash.com/photo-1519741497674-611481863552?w=400",
      "description": "The Premier Luxury Wedding & Haute Couture Editorial Journal",
      "sameAs": [
        "https://luxima.id",
        "https://www.instagram.com/luxima.id"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://blog.luxima.id/#website",
      "url": "https://blog.luxima.id",
      "name": "LUXIMA Magazine",
      "publisher": { "@id": "https://blog.luxima.id/#organization" },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://blog.luxima.id/blog?search={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Open Graph / SEO -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <!-- Canonical & AI Engine Hints -->
  <link rel="canonical" href={canonicalUrl} />
  <link rel="preconnect" href="https://images.unsplash.com" />
  <link rel="dns-prefetch" href="https://images.unsplash.com" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="LUXIMA Magazine" />
  <meta property="og:locale" content="id_ID" />

  <!-- JSON-LD Structured Data for AEO / GEO -->
  <script type="application/ld+json" set:html={JSON.stringify(globalSchema)} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23a88857'><path d='M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z'/></svg>" />

  <!-- Fonts & Global Styles -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Urbanist:wght@200;300;400;500;600;700&display=swap" rel="stylesheet" />
  
  <ClientRouter />
</head>
<body class="bg-[#FAF9F6] text-[#1A1A1A] antialiased selection:bg-[#a88857]/20 selection:text-[#87693b] pb-24 md:pb-0">

  <!-- Accessibility Skip to Main Content Landmark -->
  <a 
    href="#main-content" 
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[999999] focus:px-5 focus:py-2.5 focus:bg-[#1A1A1A] focus:text-white focus:rounded-full text-xs uppercase tracking-widest font-semibold focus:border focus:border-[#a88857] focus:shadow-2xl focus:outline-none"
  >
    Lewati ke konten utama
  </a>

  <!-- LUXURY EDITORIAL PRELOADER -->
  <div id="luxury-preloader" class="fixed inset-0 z-[99999] bg-[#FAF9F6] flex flex-col justify-between p-8 sm:p-12 pointer-events-auto select-none">
    <!-- Top Row -->
    <div class="flex items-center justify-between text-xs tracking-[0.25em] text-[#a88857] uppercase font-light">
      <span>LUXIMA EDITORIAL</span>
      <span>VOL. 08 • 2026</span>
    </div>

    <!-- Center Monogram & Title -->
    <div class="text-center max-w-lg mx-auto">
      <div class="relative inline-block mb-4">
        <span class="font-editorial text-5xl sm:text-7xl font-semibold tracking-[0.25em] text-[#1A1A1A] block">LUXIMA</span>
        <span class="block text-[10px] sm:text-xs tracking-[0.4em] text-[#a88857] font-light uppercase mt-1">WEDDING JOURNAL</span>
      </div>
      <p class="text-xs text-neutral-500 font-light tracking-wider mt-2 font-editorial">
        “Kurasi kemegahan cinta abadi dan busana pengantin haute couture...”
      </p>
      
      <!-- Progress Bar & Number -->
      <div class="mt-8 max-w-xs mx-auto">
        <div class="w-full h-[2px] bg-neutral-200 rounded-full overflow-hidden relative">
          <div id="preloader-bar" class="absolute top-0 left-0 bottom-0 bg-gradient-to-r from-[#c5a880] to-[#87693b] w-0 transition-all duration-75"></div>
        </div>
        <div class="mt-3 flex items-center justify-between text-[11px] font-mono text-[#a88857]">
          <span>INITIALIZING</span>
          <span id="preloader-counter">0%</span>
        </div>
      </div>
    </div>

    <!-- Bottom Row -->
    <div class="flex items-center justify-between text-[10px] tracking-widest text-neutral-400 uppercase font-light">
      <span>PARIS • BALI • COMO • KYOTO</span>
      <span>ALL RIGHTS RESERVED</span>
    </div>
  </div>

  <!-- Reading Progress Bar -->
  <div id="reading-progress"></div>

  <!-- Ambient Ambient Lighting Orbs -->
  <div class="fixed inset-0 pointer-events-none overflow-hidden z-0">
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-[#c5a880]/15 rounded-full blur-3xl animate-ambient"></div>
    <div class="absolute top-1/3 -right-40 w-[30rem] h-[30rem] bg-[#a88857]/10 rounded-full blur-3xl animate-ambient-delay"></div>
    <div class="absolute -bottom-20 left-1/4 w-[28rem] h-[28rem] bg-[#d4af37]/10 rounded-full blur-3xl animate-ambient"></div>
  </div>

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-5 right-5 z-[999] flex flex-col gap-3 pointer-events-none max-w-sm w-full px-4"></div>

  <!-- Top Announcement Bar / Masthead Ticker -->
  <div class="relative z-50 bg-[#1A1A1A] text-[#FAF9F6] text-xs py-2 px-4 border-b border-[#a88857]/30">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-3 tracking-widest text-[10px] md:text-xs uppercase font-light">
        <span class="inline-block w-2 h-2 rounded-full bg-[#a88857] animate-pulse"></span>
        <span>LUXIMA WEDDING MAGAZINE • EDISI DIGITAL MUSIM GUGUR • VOL. 08</span>
      </div>
      <div class="flex items-center gap-4 text-[11px] font-light">
        <a href="https://luxima.id" target="_blank" class="hover:text-[#c5a880] transition-colors hidden sm:inline">LUXIMA.ID</a>
        <span class="text-[#404040] hidden sm:inline">•</span>
        <a href="/magazine" class="text-[#c5a880] hover:text-white transition-colors flex items-center gap-1.5 font-medium">
          <span>Edisi Digital Vol. 08</span>
          <span>→</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Sticky Luxury Glass Navigation -->
  <header class="sticky top-0 z-40 glass-nav transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        
        <!-- Left: Hamburger & Primary Desktop Menu -->
        <div class="flex items-center gap-6">
          <button onclick="toggleMobileDrawer()" class="md:hidden p-2 rounded-xl text-[#1A1A1A] hover:bg-[#a88857]/10 transition-colors" aria-label="Buka Menu Navigasi Utama">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          
          <nav class="hidden md:flex items-center gap-8 text-sm uppercase tracking-wider font-light">
            <a href="/" class={`py-1 border-b transition-all ${activeNav === 'home' ? 'border-[#a88857] text-[#a88857] font-medium' : 'border-transparent hover:border-[#a88857] hover:text-[#a88857]'}`}>Beranda</a>
            <a href="/magazine" class={`py-1 border-b transition-all ${activeNav === 'magazine' ? 'border-[#a88857] text-[#a88857] font-medium' : 'border-transparent hover:border-[#a88857] hover:text-[#a88857]'}`}>Magazine & Editorial</a>
            <a href="/categories" class={`py-1 border-b transition-all ${activeNav === 'categories' ? 'border-[#a88857] text-[#a88857] font-medium' : 'border-transparent hover:border-[#a88857] hover:text-[#a88857]'}`}>Kategori</a>
            <a href="/about" class={`py-1 border-b transition-all ${activeNav === 'about' ? 'border-[#a88857] text-[#a88857] font-medium' : 'border-transparent hover:border-[#a88857] hover:text-[#a88857]'}`}>Tentang Redaksi</a>
          </nav>
        </div>

        <!-- Center: Editorial Masthead Logo -->
        <a href="/" class="text-center">
          <span class="block font-editorial text-2xl sm:text-3xl tracking-[0.22em] font-semibold text-[#1A1A1A] uppercase">LUXIMA</span>
          <span class="block text-[9px] sm:text-[10px] tracking-[0.35em] text-[#a88857] font-light uppercase mt-[-2px]">WEDDING JOURNAL</span>
        </a>

        <!-- Right: Search, Write, SSO Profile -->
        <div class="flex items-center gap-3">
          <!-- Search Dropdown Trigger -->
          <div class="relative">
            <button onclick="toggleSearchBar()" class="p-2.5 rounded-full text-[#1A1A1A] hover:bg-[#a88857]/10 transition-colors" title="Cari Cerita">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
            </button>
            <div id="search-modal" class="hidden absolute right-0 top-12 w-80 sm:w-96 glass-panel rounded-2xl p-4 shadow-2xl z-50">
              <div class="relative">
                <input type="text" id="live-search-input" oninput="handleLiveSearch(this.value)" placeholder="Cari venue, gaun, fotografer..." class="w-full bg-[#FAF9F6] border border-[#a88857]/30 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-[#a88857] transition-all" />
                <svg class="w-4 h-4 text-neutral-400 absolute right-3 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              </div>
              <div id="search-results-box" class="mt-3 max-h-60 overflow-y-auto luxury-scrollbar flex flex-col gap-2">
                <p class="text-xs text-neutral-400 text-center py-4">Ketik kata kunci untuk mencari cerita editorial.</p>
              </div>
            </div>
          </div>

          <!-- Write Story CTA -->
          <button onclick="openWriteModal()" class="hidden lg:flex items-center gap-2 px-4 py-2.5 rounded-full border border-[#a88857]/40 text-xs font-semibold uppercase tracking-wider text-[#87693b] hover:bg-[#a88857] hover:text-white transition-all btn-luxury cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span>Tulis Cerita</span>
          </button>

          <!-- Auth SSO User Pill -->
          <div id="auth-nav-container" class="flex items-center">
            <a href="https://auth.luxima.id/sign-in?returnTo=https://blog.luxima.id" id="login-nav-btn" class="px-5 py-2.5 rounded-full bg-[#1A1A1A] text-white text-xs font-medium uppercase tracking-wider hover:bg-[#a88857] transition-all btn-luxury">
              Masuk
            </a>
            <div id="user-profile-menu" class="hidden relative">
              <button onclick="toggleUserDropdown()" class="flex items-center gap-2 p-1.5 rounded-full hover:bg-[#a88857]/10 transition-colors border border-[#a88857]/30">
                <img id="nav-user-avatar" src="/assets/avatar-fallback.svg" alt="Avatar" onerror="this.onerror=null; this.src='/assets/avatar-fallback.svg';" class="w-8 h-8 rounded-full object-cover border border-[#a88857]" />
                <span id="nav-user-name" class="text-xs font-medium pr-1 text-[#1A1A1A] hidden sm:inline max-w-[100px] truncate">User</span>
                <svg class="w-3.5 h-3.5 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div id="user-dropdown" class="hidden absolute right-0 top-12 w-48 glass-panel rounded-2xl p-2 shadow-2xl z-50 text-xs flex flex-col gap-1">
                <div class="px-3 py-2 border-b border-neutral-100 flex items-center gap-2.5">
                  <img id="dropdown-user-avatar" src="/assets/avatar-fallback.svg" alt="Avatar" onerror="this.onerror=null; this.src='/assets/avatar-fallback.svg';" class="w-8 h-8 rounded-full object-cover border border-[#a88857]" />
                  <div class="overflow-hidden">
                    <p id="dropdown-user-name" class="font-semibold text-neutral-800 truncate text-xs"></p>
                    <p id="dropdown-user-role" class="text-[10px] text-[#a88857] uppercase font-light"></p>
                  </div>
                </div>
                <a href="https://auth.luxima.id/dashboard" target="_blank" class="px-3 py-2 rounded-xl hover:bg-[#a88857]/10 flex items-center gap-2 transition-colors">
                  <svg class="w-4 h-4 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                  <span>Profil Akun</span>
                </a>
                <button onclick="handleLogout()" class="w-full text-left px-3 py-2 rounded-xl hover:bg-red-50 text-red-600 flex items-center gap-2 transition-colors cursor-pointer">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                  <span>Keluar</span>
                </button>
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>
  </header>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-drawer" class="fixed inset-0 z-50 pointer-events-none opacity-0 transition-opacity duration-300">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-xs" onclick="toggleMobileDrawer()"></div>
    <div class="absolute left-0 top-0 bottom-0 w-4/5 max-w-sm glass-panel p-6 shadow-2xl transform -translate-x-full transition-transform duration-300 flex flex-col justify-between" id="mobile-drawer-content">
      <div>
        <div class="flex items-center justify-between pb-6 border-b border-[#a88857]/20">
          <div>
            <span class="font-editorial text-2xl tracking-[0.2em] font-semibold text-[#1A1A1A]">LUXIMA</span>
            <span class="block text-[9px] tracking-[0.3em] text-[#a88857] uppercase">MAGAZINE</span>
          </div>
          <button onclick="toggleMobileDrawer()" class="p-2 text-neutral-500 hover:text-black" aria-label="Tutup Menu Navigasi">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>

        <nav class="mt-8 flex flex-col gap-4 text-base tracking-wider uppercase font-light">
          <a href="/" class="py-2 hover:text-[#a88857] transition-colors border-b border-neutral-100 flex items-center justify-between">
            <span>Beranda</span>
            <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
          <a href="/magazine" class="py-2 hover:text-[#a88857] transition-colors border-b border-neutral-100 flex items-center justify-between">
            <span>Magazine & Editorial</span>
            <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
          <a href="/categories" class="py-2 hover:text-[#a88857] transition-colors border-b border-neutral-100 flex items-center justify-between">
            <span>Kategori & Destinasi</span>
            <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
          <a href="/about" class="py-2 hover:text-[#a88857] transition-colors border-b border-neutral-100 flex items-center justify-between">
            <span>Tentang Redaksi</span>
            <svg class="w-4 h-4 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </nav>
      </div>

      <div class="pt-6 border-t border-[#a88857]/20 flex flex-col gap-3">
        <button onclick="openWriteModal(); toggleMobileDrawer();" class="w-full py-3 rounded-xl bg-[#a88857] text-white text-xs font-semibold uppercase tracking-wider">
          Tulis Cerita Pernikahan
        </button>
        <button onclick="toggleDevStudio(); toggleMobileDrawer();" class="w-full py-3 rounded-xl border border-neutral-200 text-neutral-700 text-xs font-semibold uppercase tracking-wider">
          Developer Telemetry
        </button>
      </div>
    </div>
  </div>

  <!-- MAIN CONTENT SLOT -->
  <main id="main-content" tabindex="-1" class="relative z-10 min-h-screen focus:outline-none">
    <slot />
  </main>

  <!-- LUXURY EDITORIAL FOOTER -->
  <footer class="bg-[#1A1A1A] text-[#FAF9F6] border-t border-[#a88857]/30 pt-16 pb-12 relative z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-neutral-800">
        
        <div class="md:col-span-2">
          <span class="font-editorial text-3xl tracking-[0.2em] font-semibold text-white">LUXIMA</span>
          <span class="block text-[10px] tracking-[0.35em] text-[#c5a880] uppercase mt-1">WEDDING MAGAZINE & JOURNAL</span>
          <p class="text-xs text-neutral-400 font-light mt-4 max-w-sm leading-relaxed">
            Kurasi kemewahan pernikahan kelas dunia, perhiasan adiluhung, busana bridal haute couture, dan destinasi bersejarah di seluruh penjuru dunia.
          </p>
        </div>

        <div>
          <h5 class="text-xs uppercase tracking-widest text-[#c5a880] font-semibold mb-4">Navigasi Jurnal</h5>
          <ul class="space-y-2 text-xs font-light text-neutral-300">
            <li><a href="/" class="hover:text-[#c5a880] transition-colors">Beranda</a></li>
            <li><a href="/magazine" class="hover:text-[#c5a880] transition-colors">Edisi Majalah & Editorial</a></li>
            <li><a href="/categories" class="hover:text-[#c5a880] transition-colors">Direktori Kategori</a></li>
            <li><a href="/about" class="hover:text-[#c5a880] transition-colors">Tentang Redaksi & Manifesto</a></li>
          </ul>
        </div>

        <div>
          <h5 class="text-xs uppercase tracking-widest text-[#c5a880] font-semibold mb-4">Ekosistem LUXIMA</h5>
          <ul class="space-y-2 text-xs font-light text-neutral-300">
            <li><a href="https://luxima.id" target="_blank" class="hover:text-[#c5a880] transition-colors">LUXIMA Portal</a></li>
            <li><a href="https://dash.luxima.id" target="_blank" class="hover:text-[#c5a880] transition-colors">Vendor Dashboard</a></li>
            <li><a href="https://awedz.id" target="_blank" class="hover:text-[#c5a880] transition-colors">Awedz Client App</a></li>
            <li><a href="https://pay.luxima.id" target="_blank" class="hover:text-[#c5a880] transition-colors">LUXIMA Pay</a></li>
          </ul>
        </div>

      </div>

      <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-400 font-light gap-4">
        <p>© 2026 LUXIMA Inc. Hak Cipta Dilindungi Undang-Undang. Published with Astro & Hono.</p>
        <button onclick="window.scrollTo({ top: 0, behavior: 'smooth' })" class="hover:text-[#c5a880] transition-colors flex items-center gap-1.5 cursor-pointer">
          <span>Kembali ke Atas</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
        </button>
      </div>
    </div>
  </footer>

  <!-- FLOATING MOBILE BOTTOM NAVIGATION -->
  <div class="md:hidden fixed bottom-4 left-4 right-4 z-40 glass-nav rounded-2xl p-2 shadow-2xl border border-[#a88857]/30 flex items-center justify-around">
    <a href="/" class="p-2 text-center text-neutral-600 hover:text-[#a88857]" title="Beranda">
      <svg class="w-5 h-5 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      <span class="text-[9px] uppercase tracking-wider block mt-0.5">Home</span>
    </a>
    <a href="/magazine" class="p-2 text-center text-neutral-600 hover:text-[#a88857]" title="Majalah">
      <svg class="w-5 h-5 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      <span class="text-[9px] uppercase tracking-wider block mt-0.5">Issues</span>
    </a>
    <button onclick="openWriteModal()" class="p-2 text-center text-[#87693b] font-semibold" title="Tulis">
      <div class="w-9 h-9 rounded-full bg-[#a88857] text-white flex items-center justify-center mx-auto shadow-md">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      </div>
    </button>
    <a href="/categories" class="p-2 text-center text-neutral-600 hover:text-[#a88857]" title="Kategori">
      <svg class="w-5 h-5 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
      <span class="text-[9px] uppercase tracking-wider block mt-0.5">Topik</span>
    </a>
    <button onclick="toggleMobileDrawer()" class="p-2 text-center text-neutral-600 hover:text-[#a88857]" title="Menu">
      <svg class="w-5 h-5 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h16M4 18h16"/></svg>
      <span class="text-[9px] uppercase tracking-wider block mt-0.5">Menu</span>
    </button>
  </div>

  <!-- MODAL: WRITE STORY -->
  <div id="write-modal" class="fixed inset-0 z-50 pointer-events-none opacity-0 transition-opacity duration-300 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-xs" onclick="closeWriteModal()"></div>
    <div class="relative glass-panel rounded-3xl p-6 sm:p-8 max-w-2xl w-full border border-[#a88857]/40 shadow-2xl max-h-[90vh] overflow-y-auto luxury-scrollbar transform scale-95 transition-transform duration-300" id="write-modal-content" role="dialog" aria-modal="true" aria-labelledby="write-modal-title">
      <div class="flex items-center justify-between pb-4 border-b border-[#a88857]/20 mb-6">
        <div>
          <span class="text-[10px] uppercase tracking-widest text-[#a88857] font-semibold">Ruang Kurasi</span>
          <h3 id="write-modal-title" class="font-editorial text-2xl text-[#1A1A1A] font-semibold mt-0.5">Tulis Cerita Pernikahan</h3>
        </div>
        <button onclick="closeWriteModal()" class="p-2 text-neutral-400 hover:text-black" aria-label="Tutup Formulir Tulis Cerita">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <form onsubmit="handleCreateStory(event)" class="space-y-4 text-xs">
        <div>
          <label class="block uppercase tracking-wider font-semibold text-neutral-700 mb-1">Judul Cerita</label>
          <input type="text" id="post-title" required placeholder="Contoh: The Venetian Palace Vows of Clara & Julian" class="w-full bg-white border border-[#a88857]/30 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-[#a88857]" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block uppercase tracking-wider font-semibold text-neutral-700 mb-1">Kategori</label>
            <select id="post-category" required class="w-full bg-white border border-[#a88857]/30 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-[#a88857]">
              <option value="">Pilih Kategori...</option>
            </select>
          </div>
          <div>
            <label class="block uppercase tracking-wider font-semibold text-neutral-700 mb-1">Cover Image URL</label>
            <input type="url" id="post-cover" required placeholder="https://images.unsplash.com/..." class="w-full bg-white border border-[#a88857]/30 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-[#a88857]" />
          </div>
        </div>
        <div>
          <label class="block uppercase tracking-wider font-semibold text-neutral-700 mb-1">Deskripsi Singkat / Lead Paragraph</label>
          <textarea id="post-desc" required rows="2" placeholder="Ringkasan puitis artikel..." class="w-full bg-white border border-[#a88857]/30 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-[#a88857]"></textarea>
        </div>
        <div>
          <label class="block uppercase tracking-wider font-semibold text-neutral-700 mb-1">Konten Editorial Lengkap</label>
          <textarea id="post-content" required rows="6" placeholder="Ketik narasi editorial lengkap..." class="w-full bg-white border border-[#a88857]/30 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-[#a88857]"></textarea>
        </div>
        <div>
          <label class="block uppercase tracking-wider font-semibold text-neutral-700 mb-1">Tagar (Pisahkan dengan koma)</label>
          <input type="text" id="post-tags" placeholder="Venice, Villa, Haute Couture, Summer" class="w-full bg-white border border-[#a88857]/30 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-[#a88857]" />
        </div>
        <div class="pt-4 flex justify-end gap-3">
          <button type="button" onclick="closeWriteModal()" class="px-5 py-2.5 rounded-full border border-neutral-300 text-neutral-600 hover:bg-neutral-100 transition-colors">Batal</button>
          <button type="submit" class="px-7 py-2.5 rounded-full bg-[#1A1A1A] text-white font-semibold uppercase tracking-wider hover:bg-[#a88857] transition-all btn-luxury">Kirim Cerita</button>
        </div>
      </form>
    </div>
  </div>

  <!-- CLIENT-SIDE CORE SCRIPTS -->
  <script is:inline>
    const API_BASE = '/api';
    const AUTH_URL = 'https://auth.luxima.id';

    // Reading Progress Bar
    window.addEventListener('scroll', () => {
      const winScroll = document.documentElement.scrollTop || document.body.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
      const progressBar = document.getElementById('reading-progress');
      if (progressBar) progressBar.style.width = scrolled + '%';
    });

    // Toast Notification System
    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      if (!container) return;
      const toast = document.createElement('div');
      toast.className = 'pointer-events-auto glass-panel rounded-2xl p-4 shadow-xl border border-[#a88857]/30 flex items-start gap-3 transform transition-all duration-300 translate-y-2 opacity-0';
      
      let icon = '<svg class="w-5 h-5 text-[#a88857] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
      if (type === 'success') {
        icon = '<svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
      } else if (type === 'error') {
        icon = '<svg class="w-5 h-5 text-rose-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>';
      }

      toast.innerHTML = icon + '<div class="text-xs text-neutral-800 leading-relaxed font-light flex-1">' + message + '</div>';
      container.appendChild(toast);

      requestAnimationFrame(() => toast.classList.remove('translate-y-2', 'opacity-0'));
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-y-2');
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }
    window.showToast = showToast;

    // Search Toggle & Debounce
    let searchTimeout = null;
    function toggleSearchBar() {
      const modal = document.getElementById('search-modal');
      if (modal) {
        modal.classList.toggle('hidden');
        if (!modal.classList.contains('hidden')) {
          document.getElementById('live-search-input')?.focus();
        }
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function handleLiveSearch(query) {
      clearTimeout(searchTimeout);
      const resultsBox = document.getElementById('search-results-box');
      if (!query || query.trim().length < 2) {
        resultsBox.innerHTML = '<p class="text-xs text-neutral-400 text-center py-4">Ketik minimal 2 karakter...</p>';
        return;
      }

      searchTimeout = setTimeout(async () => {
        try {
          const res = await fetch(API_BASE + '/posts?search=' + encodeURIComponent(query) + '&limit=5');
          const json = await res.json();
          if (json.success && Array.isArray(json.data) && json.data.length > 0) {
            resultsBox.innerHTML = json.data.map(p => `
              <a href="/blog/${p.slug}" class="p-2 rounded-xl hover:bg-[#a88857]/10 cursor-pointer transition-colors flex items-center gap-3">
                <img src="${p.cover_image || 'https://images.unsplash.com/photo-1519741497674-611481863552?w=100'}" class="w-10 h-10 rounded-lg object-cover" />
                <div class="overflow-hidden">
                  <span class="block text-xs font-semibold text-[#1A1A1A] truncate">${escapeHtml(p.title)}</span>
                  <span class="block text-[10px] text-neutral-400 font-light">${escapeHtml(p.category?.name || 'Cerita')}</span>
                </div>
              </a>
            `).join('');
          } else {
            resultsBox.innerHTML = '<p class="text-xs text-neutral-400 text-center py-4">Tidak ada cerita yang cocok.</p>';
          }
        } catch (err) {
          resultsBox.innerHTML = '<p class="text-xs text-red-400 text-center py-4">Pencarian gagal.</p>';
        }
      }, 300);
    }

    // Mobile Drawer
    function toggleMobileDrawer() {
      const drawer = document.getElementById('mobile-drawer');
      const content = document.getElementById('mobile-drawer-content');
      const isOpen = !drawer.classList.contains('pointer-events-none');
      if (isOpen) {
        drawer.classList.add('pointer-events-none', 'opacity-0');
        content.classList.add('-translate-x-full');
      } else {
        drawer.classList.remove('pointer-events-none', 'opacity-0');
        content.classList.remove('-translate-x-full');
      }
    }



    // Write Modal
    function openWriteModal() {
      const modal = document.getElementById('write-modal');
      const content = document.getElementById('write-modal-content');
      modal.classList.remove('pointer-events-none', 'opacity-0');
      content.classList.remove('scale-95');

      // Populate categories
      fetch(API_BASE + '/categories').then(r => r.json()).then(j => {
        if (j.success && Array.isArray(j.data)) {
          const select = document.getElementById('post-category');
          if (select) {
            select.innerHTML = '<option value="">Pilih Kategori...</option>' + j.data.map(c => '<option value="' + c.id + '">' + c.name + '</option>').join('');
          }
        }
      });
    }

    function closeWriteModal() {
      const modal = document.getElementById('write-modal');
      const content = document.getElementById('write-modal-content');
      modal.classList.add('pointer-events-none', 'opacity-0');
      content.classList.add('scale-95');
    }

    // SSO Token Helpers
    function getAuthToken() {
      const match = document.cookie.match(/(?:^|; )sb-luxima-auth-token=([^;]*)/);
      if (match) return decodeURIComponent(match[1]);

      let chunkIndex = 0;
      let chunks = '';
      while (true) {
        const chunkMatch = document.cookie.match(new RegExp('(?:^|; )sb-luxima-auth-token\\.' + chunkIndex + '=([^;]*)'));
        if (!chunkMatch) break;
        chunks += chunkMatch[1];
        chunkIndex++;
      }

      if (chunks) {
        try {
          const decoded = decodeURIComponent(chunks);
          if (decoded.startsWith('base64-')) {
            const raw = atob(decoded.slice(7));
            const parsed = JSON.parse(raw);
            return parsed.access_token || parsed[0];
          }
          const parsed = JSON.parse(decoded);
          return parsed.access_token || parsed[0];
        } catch (e) {
          return chunks;
        }
      }
      return localStorage.getItem('token') || null;
    }

    function checkAuth() {
      const token = getAuthToken();
      const userNameMatch = document.cookie.match(/(?:^|; )Auth_name=([^;]*)/);
      const userRoleMatch = document.cookie.match(/(?:^|; )Auth_role=([^;]*)/);
      const userAvatarMatch = document.cookie.match(/(?:^|; )Auth_avatar=([^;]*)/);
      const userName = userNameMatch ? decodeURIComponent(userNameMatch[1]) : localStorage.getItem('Auth_name');
      const userRole = userRoleMatch ? decodeURIComponent(userRoleMatch[1]) : localStorage.getItem('Auth_role');
      let userAvatar = userAvatarMatch ? decodeURIComponent(userAvatarMatch[1]) : localStorage.getItem('Auth_avatar');

      const loginBtn = document.getElementById('login-nav-btn');
      const profileMenu = document.getElementById('user-profile-menu');
      const navAvatar = document.getElementById('nav-user-avatar');
      const dropAvatar = document.getElementById('dropdown-user-avatar');

      if (token && (userName || userRole)) {
        loginBtn?.classList.add('hidden');
        profileMenu?.classList.remove('hidden');
        if (navAvatar) navAvatar.src = userAvatar || '/assets/avatar-fallback.svg';
        if (dropAvatar) dropAvatar.src = userAvatar || '/assets/avatar-fallback.svg';
        const nameEl = document.getElementById('nav-user-name');
        if (nameEl) nameEl.innerText = userName || 'Curator';
        const dropNameEl = document.getElementById('dropdown-user-name');
        if (dropNameEl) dropNameEl.innerText = userName || 'Curator';
        const dropRoleEl = document.getElementById('dropdown-user-role');
        if (dropRoleEl) dropRoleEl.innerText = (userRole || 'Member') + ' • LUXIMA';

        // Async fetch fresh profile from database via /api/auth/me
        fetch(API_BASE + '/auth/me', { headers: { Authorization: 'Bearer ' + token } })
          .then(r => r.json())
          .then(res => {
            if (res.success && res.data) {
              const freshAvatar = res.data.avatar || '/assets/avatar-fallback.svg';
              const freshName = res.data.fullName || res.data.username || userName;
              localStorage.setItem('Auth_avatar', freshAvatar);
              if (navAvatar) navAvatar.src = freshAvatar;
              if (dropAvatar) dropAvatar.src = freshAvatar;
              if (freshName) {
                localStorage.setItem('Auth_name', freshName);
                if (nameEl) nameEl.innerText = freshName;
                if (dropNameEl) dropNameEl.innerText = freshName;
              }
            }
          })
          .catch(() => {});
      } else {
        loginBtn?.classList.remove('hidden');
        profileMenu?.classList.add('hidden');
      }
    }

    function toggleUserDropdown() {
      document.getElementById('user-dropdown')?.classList.toggle('hidden');
    }

    function handleLogout() {
      const domains = ['.luxima.id', '.awedz.id', '.localhost', 'localhost'];
      const cookies = ['sb-luxima-auth-token', 'Auth_name', 'Auth_role', 'Auth_tier'];
      cookies.forEach(c => {
        document.cookie = c + '=; Max-Age=0; path=/;';
        domains.forEach(d => { document.cookie = c + '=; Max-Age=0; domain=' + d + '; path=/;'; });
        for (let i = 0; i < 5; i++) {
          document.cookie = c + '.' + i + '=; Max-Age=0; path=/;';
          domains.forEach(d => { document.cookie = c + '.' + i + '=; Max-Age=0; domain=' + d + '; path=/;'; });
        }
      });
      localStorage.removeItem('Auth_name');
      localStorage.removeItem('Auth_role');
      localStorage.removeItem('Auth_tier');
      localStorage.removeItem('Auth_avatar');
      localStorage.removeItem('token');
      sessionStorage.clear();
      fetch(API_BASE + '/auth/logout', { method: 'POST', credentials: 'include' }).catch(() => {});
      showToast('Berhasil keluar. Mengalihkan ke SSO...', 'info');
      setTimeout(() => {
        window.location.href = AUTH_URL + '/api/sso/logout?returnTo=' + encodeURIComponent(window.location.origin);
      }, 600);
    }

    async function handleCreateStory(e) {
      e.preventDefault();
      const title = document.getElementById('post-title').value.trim();
      const category_id = document.getElementById('post-category').value;
      const cover_image = document.getElementById('post-cover').value.trim();
      const description = document.getElementById('post-desc').value.trim();
      const content = document.getElementById('post-content').value.trim();
      const tagsStr = document.getElementById('post-tags').value.trim();
      const tags = tagsStr ? tagsStr.split(',').map(t => t.trim()).filter(Boolean) : [];

      const token = getAuthToken();
      if (!token) {
        showToast('Silakan masuk terlebih dahulu untuk mengirim cerita.', 'error');
        window.location.href = AUTH_URL + '/sign-in?returnTo=' + encodeURIComponent(window.location.href);
        return;
      }

      try {
        const res = await fetch(API_BASE + '/posts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
          body: JSON.stringify({ title, category_id, cover_image, description, content, tags })
        });
        const json = await res.json();
        if (json.success) {
          showToast('Cerita berhasil diterbitkan! Memuat ulang...', 'success');
          closeWriteModal();
          setTimeout(() => window.location.reload(), 800);
        } else {
          showToast(json.message || 'Gagal menerbitkan cerita.', 'error');
        }
      } catch (err) {
        showToast('Koneksi gagal.', 'error');
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      checkAuth();
    });
  </script>
  <!-- Awwwards-grade GSAP & Lenis Smooth Motion Module -->
  <script>
    import '../scripts/animations';
  </script>
</body>
</html>
