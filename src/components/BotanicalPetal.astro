---
interface Props {
  color?: 'sage' | 'sand' | 'gold' | 'charcoal' | string;
  size?: number | string;
  rotate?: number;
  class?: string;
  opacity?: number | string;
}

const {
  color = 'sage',
  size = 120,
  rotate = 0,
  class: className = '',
  opacity = '0.85'
} = Astro.props;

// Resolved color mapping based on editorial reference
const colorMap: Record<string, string> = {
  sage: '#98A68B',
  sand: '#D8C2A7',
  gold: '#A88857',
  charcoal: '#1A1A1A'
};

const fillColor = colorMap[color] || color;
---

<div 
  class={`petal-decor select-none pointer-events-none ${className}`} 
  style={`width: ${typeof size === 'number' ? size + 'px' : size}; height: ${typeof size === 'number' ? size + 'px' : size}; transform: rotate(${rotate}deg); opacity: ${opacity};`}
>
  <svg 
    viewBox="0 0 200 200" 
    fill="none" 
    xmlns="http://www.w3.org/2000/svg"
    class="w-full h-full drop-shadow-sm"
  >
    <defs>
      <linearGradient id={`petal-grad-${color}`} x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color={fillColor} stop-opacity="0.95" />
        <stop offset="100%" stop-color={fillColor} stop-opacity="0.75" />
      </linearGradient>
    </defs>
    <g transform="translate(100, 100)">
      <!-- Top Petal -->
      <g transform="rotate(0)">
        <path d="M 0 0 C -16 -25, -23 -62, 0 -82 C 23 -62, 16 -25, 0 0 Z" fill={`url(#petal-grad-${color})`} />
      </g>
      <!-- Right Petal -->
      <g transform="rotate(90)">
        <path d="M 0 0 C -16 -25, -23 -62, 0 -82 C 23 -62, 16 -25, 0 0 Z" fill={`url(#petal-grad-${color})`} />
      </g>
      <!-- Bottom Petal -->
      <g transform="rotate(180)">
        <path d="M 0 0 C -16 -25, -23 -62, 0 -82 C 23 -62, 16 -25, 0 0 Z" fill={`url(#petal-grad-${color})`} />
      </g>
      <!-- Left Petal -->
      <g transform="rotate(270)">
        <path d="M 0 0 C -16 -25, -23 -62, 0 -82 C 23 -62, 16 -25, 0 0 Z" fill={`url(#petal-grad-${color})`} />
      </g>
      <!-- Subtle Center Floral Core -->
      <circle cx="0" cy="0" r="3.5" fill={fillColor} opacity="0.9" />
    </g>
  </svg>
</div>
