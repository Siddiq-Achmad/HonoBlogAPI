---
import Layout from '../layouts/Layout.astro';

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
const errorMessage = error instanceof Error ? error.message : 'Penyelarasan ritme internal sedang berlangsung.';
---

<Layout 
  title="Jeda di Balik Layar • 500 Server Error — LUXIMA MAGAZINE"
  description="Layanan editorial sedang melakukan penyelarasan sistem untuk memastikan kesempurnaan tampilan."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-24">
    
    <div class="relative max-w-3xl mx-auto text-center py-16 px-6 sm:px-12 glass-panel rounded-3xl border border-[#a88857]/30 shadow-2xl overflow-hidden mb-16">
      
      <!-- Giant Artistic 500 Background Watermark -->
      <div class="absolute -top-10 left-1/2 -translate-x-1/2 pointer-events-none select-none">
        <span class="font-editorial text-[140px] sm:text-[220px] font-bold text-[#a88857]/5 tracking-[0.1em] leading-none block">
          500
        </span>
      </div>

      <div class="relative z-10">
        <span class="inline-block px-4 py-1.5 rounded-full text-[10px] sm:text-xs font-semibold uppercase tracking-[0.25em] bg-rose-50 text-rose-700 border border-rose-200 mb-6">
          Jeda di Balik Layar Atelier • 500 Internal Error
        </span>

        <h1 class="font-editorial text-4xl sm:text-6xl text-[#1A1A1A] font-semibold leading-[1.15] mb-6">
          Kesempurnaan Membutuhkan Jeda Sejenak
        </h1>

        <blockquote class="editorial-pullquote text-left text-sm sm:text-base my-6 max-w-xl mx-auto">
          “Layaknya busana haute couture yang dikerjakan jahitan demi jahitan oleh tangan artisan terampil, kesempurnaan sistem kami membutuhkan sesaat ruang untuk bernapas.”
        </blockquote>

        <p class="text-sm text-neutral-600 font-light max-w-md mx-auto leading-relaxed mb-8">
          Dewan teknis redaksi kami telah menerima laporan anomali ini dan sedang menyempurnakannya. Cerita dan data Anda tetap terlindungi dengan standar keamanan tertinggi.
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
          <button 
            onclick="window.location.reload()" 
            class="px-8 py-3.5 rounded-full bg-[#1A1A1A] text-white text-xs uppercase tracking-widest font-semibold hover:bg-[#a88857] transition-all btn-luxury shadow-lg cursor-pointer flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
            <span>Coba Muat Ulang</span>
          </button>
          <a 
            href="/" 
            class="px-8 py-3.5 rounded-full border border-[#a88857] text-[#87693b] text-xs uppercase tracking-widest font-semibold hover:bg-[#a88857]/10 transition-all btn-luxury"
          >
            Kembali ke Beranda
          </a>
        </div>

        <!-- Technical Telemetry Collapsible for Developers -->
        <details class="text-left max-w-lg mx-auto bg-neutral-900/90 text-neutral-300 p-4 rounded-xl text-xs font-mono border border-neutral-800 cursor-pointer">
          <summary class="text-neutral-400 font-semibold hover:text-white uppercase tracking-wider text-[10px]">
            Detail Diagnostik Teknis
          </summary>
          <div class="mt-3 pt-3 border-t border-neutral-800 text-[11px] text-rose-300 overflow-x-auto">
            <p class="font-bold text-neutral-400 mb-1">Pesan Error:</p>
            <code>{errorMessage}</code>
            <p class="font-bold text-neutral-400 mt-2 mb-1">Timestamp:</p>
            <code>{new Date().toISOString()}</code>
          </div>
        </details>

      </div>

    </div>

  </div>
</Layout>
