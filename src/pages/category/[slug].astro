---
import Layout from '../../layouts/Layout.astro';
import BotanicalPetal from '../../components/BotanicalPetal.astro';
import { supabase, supabaseAdmin } from '../../lib/supabase.js';
import { getCategoryImageUrl, getPostCoverUrl, getUserAvatarUrl } from '../../lib/images.js';
import { getPostSanctuaryDetails } from '../../lib/sanctuary.js';

const { slug } = Astro.params;

const client = supabaseAdmin || supabase;

// Find category by slug
const { data: category, error: catError } = await client
  .from('categories')
  .select('*')
  .eq('slug', slug)
  .single();

if (!category || catError) {
  return Astro.redirect('/categories');
}

const categoryImage = getCategoryImageUrl(category.image, { width: 1920, quality: 80 });

// Find posts in this category
const { data: posts } = await client
  .from('posts')
  .select('*, author:profiles_view(id, fullName, avatar), category:categories(id, name, slug, image)')
  .eq('category_id', category.id)
  .order('created_at', { ascending: false });
---

<Layout title={`${category.name} — LUXIMA MAGAZINE`} activeNav="categories">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24 relative overflow-hidden">
    
    <!-- Floating Botanical Petals -->
    <BotanicalPetal color="sand" size={240} rotate={20} opacity="0.3" class="absolute top-10 -right-16 petal-float" />
    <BotanicalPetal color="sage" size={180} rotate={-10} opacity="0.25" class="absolute top-48 -left-12 petal-float-rev" />

    <!-- Breadcrumb Navigation -->
    <nav class="flex items-center gap-2 text-xs uppercase tracking-wider text-neutral-400 mb-6 font-light relative z-10">
      <a href="/" class="hover:text-[#a88857] transition-colors">LUXIMA</a>
      <span>/</span>
      <a href="/categories" class="hover:text-[#a88857] transition-colors">Kategori</a>
      <span>/</span>
      <span class="text-[#a88857] font-medium">{category.name}</span>
    </nav>

    <!-- Editorial Category Hero Banner with R2 CDN Image -->
    <div class="relative rounded-3xl overflow-hidden mb-16 border border-[#a88857]/30 shadow-xl bg-[#1A1A1A]">
      <div class="absolute inset-0">
        <img 
          src={categoryImage} 
          alt={category.name} 
          onerror="this.onerror=null; this.src='https://r2.luxima.id/cdn-cgi/image/width=1080,quality=75,format=auto/assets/categories/wedding-organizer.webp';"
          class="w-full h-full object-cover opacity-45 scale-105 transition-transform duration-1000"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/30 backdrop-blur-[1px]" />
      </div>

      <div class="relative z-10 p-8 sm:p-14 md:p-16 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-[#a88857]/40 text-[#d8c2a7] text-xs font-semibold uppercase tracking-widest mb-4">
          {category.icon && <span class="text-sm">{category.icon}</span>}
          <span>Kurasi Tematik LUXIMA</span>
        </div>

        <h1 class="font-editorial text-4xl sm:text-6xl text-white font-semibold leading-tight drop-shadow-md">
          {category.name}
        </h1>

        <p class="text-sm sm:text-base text-neutral-300 font-light mt-4 leading-relaxed max-w-2xl drop-shadow">
          {category.description || `Eksplorasi mendalam seputar panduan, tren busana, estetika tradisi, dan liputan eksklusif dalam kurasi ${category.name}.`}
        </p>

        <div class="mt-8 flex items-center gap-6 text-xs text-neutral-300 font-light border-t border-white/15 pt-4">
          <span class="inline-flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[#a88857]"></span>
            <strong class="font-semibold text-white">{posts ? posts.length : 0}</strong> Cerita Diterbitkan
          </span>
          <span>•</span>
          <span class="text-[#d8c2a7]">Standar Kurasi Editorial Nusantara</span>
        </div>
      </div>
    </div>

    <!-- Posts Grid in this Category -->
    {posts && posts.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 relative z-10">
        {posts.map(post => {
          const coverUrl = getPostCoverUrl(post.cover_image, { width: 800, quality: 75 });
          const sanctuaryInfo = getPostSanctuaryDetails(post);
          const authorAvatar = getUserAvatarUrl(post.author?.avatar);
          const authorName = post.author?.fullName || 'LUXIMA Editorial';
          
          return (
            <article class="glass-card rounded-2xl overflow-hidden flex flex-col justify-between group border border-[#a88857]/20 hover:border-[#a88857]/50 hover:shadow-xl transition-all duration-500 bg-white">
              <a href={`/blog/${post.slug}`} class="block flex-1 flex flex-col">
                <div class="aspect-[16/11] overflow-hidden relative">
                  <img 
                    src={coverUrl} 
                    alt={post.title} 
                    loading="lazy"
                    decoding="async"
                    onerror="this.onerror=null; this.src='https://r2.luxima.id/cdn-cgi/image/width=800,quality=75,format=auto/images/hero/aceh-venue.jpg';"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-106" 
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent flex items-end justify-between p-4 z-10">
                    <span class="px-2.5 py-0.5 rounded-full text-[9px] uppercase tracking-wider font-semibold bg-white/95 backdrop-blur-md text-[#87693b] shadow-sm">
                      {category.name}
                    </span>
                    <span class="text-[9px] uppercase tracking-widest font-semibold text-white/90 bg-black/40 backdrop-blur-sm px-2 py-0.5 rounded-full">
                      {sanctuaryInfo.tag}
                    </span>
                  </div>
                </div>
                <div class="p-6 flex-1 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between text-[10px] uppercase tracking-wider text-neutral-400 font-light mb-2">
                      <span class="text-[#a88857] font-semibold">{sanctuaryInfo.sanctuary}</span>
                      <span>{post.reading_time || 5} Menit Baca</span>
                    </div>
                    <h3 class="font-editorial text-2xl font-semibold text-[#1A1A1A] group-hover:text-[#a88857] transition-colors leading-tight line-clamp-2">
                      {post.title}
                    </h3>
                    <p class="text-xs text-neutral-500 font-light mt-2.5 line-clamp-3 leading-relaxed">
                      {post.description}
                    </p>
                  </div>
                </div>
              </a>
              <div class="px-6 pb-6 pt-2 flex items-center justify-between text-xs font-light text-neutral-400 border-t border-neutral-100">
                <div class="flex items-center gap-2">
                  <img 
                    src={authorAvatar} 
                    alt={authorName} 
                    onerror="this.onerror=null; this.src='/assets/avatar-fallback.svg';" 
                    class="w-6 h-6 rounded-full object-cover border border-[#a88857]"
                  />
                  <span class="text-neutral-600 truncate max-w-[120px]">{authorName}</span>
                </div>
                <a href={`/blog/${post.slug}`} class="text-[#87693b] font-medium group-hover:translate-x-1 transition-transform flex items-center gap-1">
                  <span>Baca Cerita</span>
                  <span>→</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="p-16 text-center glass-panel rounded-3xl border border-[#a88857]/20 relative z-10">
        <span class="text-4xl block mb-3">🌿</span>
        <p class="font-editorial text-2xl text-neutral-700">Belum ada cerita yang diterbitkan dalam kategori ini.</p>
        <p class="text-xs text-neutral-500 font-light mt-2 max-w-md mx-auto">
          Redaksi kami tengah menyiapkan liputan khusus dan kurasi terhangat untuk topik ini. Silakan kunjungi arsip lainnya.
        </p>
        <a href="/categories" class="mt-6 inline-flex px-6 py-2.5 rounded-full bg-[#1A1A1A] text-white text-xs uppercase tracking-wider font-semibold hover:bg-[#a88857] transition-all">
          ← Kembali ke Semua Kategori
        </a>
      </div>
    )}

  </div>
</Layout>
