---
import Layout from '../../layouts/Layout.astro';
import BotanicalPetal from '../../components/BotanicalPetal.astro';
import { supabaseAdmin, supabase } from '../../lib/supabase.js';
import { getPostCoverUrl, getUserAvatarUrl } from '../../lib/images.js';
import { getPostSanctuaryDetails } from '../../lib/sanctuary.js';

const client = supabaseAdmin || supabase;

const { data: posts } = await client
  .from('posts')
  .select('*, author:profiles_view(id, fullName, avatar), category:categories(id, name, slug)')
  .order('created_at', { ascending: false });

const { data: categories } = await client
  .from('categories')
  .select('*')
  .eq('status', 'active')
  .order('sort_order', { ascending: true })
  .order('name');

const totalPosts = posts ? posts.length : 16;
---

<Layout title="Warta & Editorial Wedding Indonesia — LUXIMA MAGAZINE" activeNav="home">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-24 relative overflow-hidden">
    
    <!-- Floating Botanical Petals -->
    <BotanicalPetal color="sage" size={210} rotate={-10} opacity="0.35" class="absolute top-10 -left-16 petal-float" />
    <BotanicalPetal color="sand" size={190} rotate={20} opacity="0.4" class="absolute top-28 -right-12 petal-float-rev" />

    <div class="text-center max-w-3xl mx-auto mb-16 relative z-10">
      <span class="text-xs uppercase tracking-[0.3em] text-[#87693b] font-semibold">Koleksi Editorial Pernikahan Nusantara</span>
      <h1 class="font-editorial text-4xl sm:text-6xl text-[#1A1A1A] font-semibold mt-2">Warta & Editorial Wedding Indonesia</h1>
      <p class="text-base text-neutral-600 font-light mt-4 leading-relaxed">
        Kurasi menyeluruh {totalPosts} liputan editorial pernikahan mewah Indonesia, ulasan suaka eksotis Nusantara, filosofi adat sakral, hingga kriya busana kebaya couture.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex items-center justify-center gap-2.5 overflow-x-auto no-scrollbar pt-8">
        <a href="/blog" class="px-5 py-2 rounded-full text-xs font-semibold uppercase tracking-wider bg-[#1A1A1A] text-white">
          Semua
        </a>
        {categories && categories.map(cat => (
          <a 
            href={`/category/${cat.slug}`} 
            class="px-5 py-2 rounded-full text-xs font-medium uppercase tracking-wider bg-white border border-[#a88857]/30 text-neutral-700 hover:bg-[#a88857]/10 transition-colors"
          >
            {cat.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Bento Grid of Stories -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 relative z-10">
      {posts && posts.map((post, idx) => {
        const coverUrl = getPostCoverUrl(post.cover_image, { width: 800, quality: 75 });
        const sanctuaryInfo = getPostSanctuaryDetails(post);
        const authorAvatar = getUserAvatarUrl(post.author?.avatar);
        const authorName = post.author?.fullName || 'LUXIMA Editorial';
        const shapeClass = idx % 3 === 0 ? 'bento-arch-card shape-arch' : (idx % 3 === 1 ? 'bento-card shape-leaf-1' : 'bento-card rounded-3xl');
        
        return (
          <article class={`${shapeClass} bg-white border border-[#a88857]/25 flex flex-col justify-between group shadow-sm hover:shadow-xl transition-all duration-500`}>
            <a href={`/blog/${post.slug}`} class="block flex-1 flex flex-col">
              <div class="aspect-[16/11] overflow-hidden relative">
                <img 
                  src={coverUrl}
                  onerror="this.onerror=null; this.src='https://r2.luxima.id/cdn-cgi/image/width=800,quality=75,format=auto/images/hero/aceh-venue.jpg';" 
                  alt={post.title}
                  loading="lazy"
                  decoding="async"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-108"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-transparent flex items-end justify-between p-4 z-10">
                  <span class="px-3 py-1 rounded-full text-[9px] uppercase tracking-wider font-semibold bg-white/95 backdrop-blur-md text-[#87693b] shadow-sm">
                    {post.category?.name || 'Editorial'}
                  </span>
                  <span class="text-[9px] uppercase tracking-widest font-semibold text-white/90 bg-black/40 backdrop-blur-sm px-2.5 py-0.5 rounded-full">
                    {sanctuaryInfo.tag}
                  </span>
                </div>
              </div>
              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between text-[10px] uppercase tracking-widest text-neutral-400 font-light mb-1.5">
                    <span class="text-[#a88857] font-semibold">{sanctuaryInfo.sanctuary}</span>
                    <span>{post.reading_time || 5} Min Baca</span>
                  </div>
                  <h3 class="font-editorial text-2xl font-semibold text-[#1A1A1A] group-hover:text-[#a88857] transition-colors leading-snug">
                    {post.title}
                  </h3>
                  <p class="text-xs text-neutral-500 font-light mt-2.5 line-clamp-2 leading-relaxed">
                    {post.description}
                  </p>
                </div>
                
                <div class="pt-4 border-t border-neutral-100 flex items-center justify-between mt-4">
                  <div class="flex items-center gap-2">
                    <img
                      src={authorAvatar}
                      alt={authorName}
                      onerror="this.onerror=null; this.src='/assets/avatar-fallback.svg';"
                      class="w-6 h-6 rounded-full object-cover border border-[#a88857]/40"
                    />
                    <span class="text-[11px] text-neutral-600 font-light">{authorName}</span>
                  </div>
                  <div class="text-xs font-semibold text-[#87693b] flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                    <span>Baca Cerita</span>
                    <span>→</span>
                  </div>
                </div>
              </div>
            </a>
          </article>
        );
      })}
    </div>

  </div>
</Layout>
