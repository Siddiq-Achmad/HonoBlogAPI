---
import Layout from "../../layouts/Layout.astro";
import { supabaseAdmin, supabase } from "../../lib/supabase.js";
import { getPostCoverUrl, getUserAvatarUrl } from "../../lib/images.js";
import { getPostSanctuaryDetails } from "../../lib/sanctuary.js";

const { slug } = Astro.params;

const client = supabaseAdmin || supabase;

// Fetch current post
const { data: post, error } = await client
  .from("posts")
  .select(
    "*, author:profiles_view(id, fullName, avatar), category:categories(id, name, slug)",
  )
  .eq("slug", slug)
  .single();

if (!post || error) {
  return Astro.redirect("/");
}

// Fetch related posts from same category or recent
const { data: relatedPosts } = await client
  .from("posts")
  .select("*, category:categories(name, slug)")
  .eq("category_id", post.category_id)
  .neq("id", post.id)
  .limit(3);

// Fetch comments with author profile
const { data: comments } = await client
  .from("comments")
  .select("*, user:profiles_view(id, fullName, avatar)")
  .eq("post_id", post.id)
  .order("created_at", { ascending: false });

const paragraphs = (post.content || post.description || "")
  .split("\n")
  .filter((p) => p.trim() !== "");
const firstParagraph = paragraphs.length > 0 ? paragraphs[0] : post.description;
const remainingParagraphs = paragraphs.slice(1);

const canonicalUrl = new URL(Astro.url.pathname, "https://blog.luxima.id").href;

const authorAvatar = getUserAvatarUrl(post.author?.avatar);
const authorName = post.author?.fullName || "Siddiq Achmad";

const postCoverUrl = getPostCoverUrl(post.cover_image, { width: 1200, quality: 75 });
const sanctuaryDetails = getPostSanctuaryDetails(post);

// Article & BreadcrumbList Schema for Google Rich Results, Perplexity, & AEO
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalUrl,
  },
  headline: post.title,
  description: post.description,
  image: [postCoverUrl],
  datePublished: post.created_at,
  dateModified: post.updated_at || post.created_at,
  author: {
    "@type": "Person",
    name: authorName,
  },
  publisher: {
    "@type": "Organization",
    name: "LUXIMA",
    logo: {
      "@type": "ImageObject",
      url: "https://r2.luxima.id/cdn-cgi/image/width=480,quality=75,format=auto/assets/general/ceremony.webp",
    },
  },
  articleSection: post.category?.name || "Wedding Editorial",
  wordCount: (post.content || "").split(/\s+/).length,
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "LUXIMA",
      item: "https://blog.luxima.id",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: post.category?.name || "Kategori",
      item: `https://blog.luxima.id/category/${post.category?.slug || "editorial"}`,
    },
    {
      "@type": "ListItem",
      position: 3,
      name: post.title,
      item: canonicalUrl,
    },
  ],
};
---

<Layout
  title={`${post.title} — LUXIMA MAGAZINE`}
  description={post.description}
  ogImage={postCoverUrl}
  activeNav="home"
>
  <!-- JSON-LD Structured Data for Article & Breadcrumbs (AEO / GEO) -->
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbSchema)}
  />

  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-24">
    <!-- Breadcrumbs -->
    <nav
      class="flex items-center gap-2 text-xs uppercase tracking-wider text-neutral-400 mb-8 font-light"
    >
      <a href="/" class="hover:text-[#a88857] transition-colors">LUXIMA</a>
      <span>/</span>
      <a
        href={`/category/${post.category?.slug || ""}`}
        class="text-neutral-600 hover:text-[#a88857] transition-colors"
      >
        {post.category?.name || "Category"}
      </a>
      <span>/</span>
      <span class="text-[#a88857] truncate max-w-[200px] sm:max-w-xs"
        >{post.title}</span
      >
    </nav>

    <!-- Article Header -->
    <header class="mb-10 text-center">
      <div class="flex items-center justify-center gap-2 mb-4">
        <span
          class="inline-block px-4 py-1 rounded-full text-xs font-medium uppercase tracking-widest bg-[#a88857]/10 text-[#87693b] border border-[#a88857]/30"
        >
          {post.category?.name || "WEDDING EDITORIAL"}
        </span>
        <span
          class="inline-block px-3 py-1 rounded-full text-xs font-medium uppercase tracking-wider bg-black/5 text-neutral-600 border border-neutral-200"
        >
          {sanctuaryDetails.tag}
        </span>
      </div>

      <div class="text-[11px] uppercase tracking-[0.25em] text-[#a88857] font-semibold mb-2">
        {sanctuaryDetails.sanctuary}
      </div>

      <h1
        class="font-editorial text-3xl sm:text-5xl md:text-6xl text-[#1A1A1A] font-semibold leading-[1.15] mb-6"
      >
        {post.title}
      </h1>
      <p
        class="text-base sm:text-lg text-neutral-600 font-light max-w-2xl mx-auto leading-relaxed mb-8"
      >
        {post.description}
      </p>

      <!-- Author, Date, Reading Time -->
      <div
        class="flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs text-neutral-500 font-light border-y border-[#a88857]/20 py-4"
      >
        <div class="flex items-center gap-2.5">
          <img
            src={authorAvatar}
            alt={authorName}
            onerror="this.onerror=null; this.src='/assets/avatar-fallback.svg';"
            class="w-8 h-8 rounded-full object-cover border border-[#a88857]"
          />
          <span class="font-semibold text-[#1A1A1A]">{authorName}</span>
        </div>
        <span>•</span>
        <time
          >{
            new Date(post.created_at).toLocaleDateString("id-ID", {
              day: "numeric",
              month: "long",
              year: "numeric",
            })
          }</time
        >
        <span>•</span>
        <span>{post.reading_time || 5} Menit Baca</span>
        <span>•</span>
        <span>{post.views || 0} Pembaca</span>
      </div>
    </header>

    <!-- Cover Image -->
    <div class="rounded-3xl overflow-hidden shadow-2xl mb-12 relative">
      <img
        src={postCoverUrl}
        alt={post.title}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        onerror="this.onerror=null; this.src='https://r2.luxima.id/cdn-cgi/image/width=1200,quality=75,format=auto/images/hero/aceh-venue.jpg';"
        class="w-full h-auto max-h-[550px] object-cover"
      />
      <div
        class="bg-white/80 backdrop-blur-md p-3 flex items-center justify-between text-[11px] text-neutral-500 font-light"
      >
        <span>{sanctuaryDetails.sanctuary}</span>
        <span>Dokumentasi Editorial LUXIMA Wedding Magazine</span>
      </div>
    </div>

    <!-- Social Share Bar -->
    <div
      class="flex items-center justify-between border-b border-[#a88857]/20 pb-6 mb-12"
    >
      <div class="flex items-center gap-3">
        <span
          class="text-xs uppercase tracking-wider text-neutral-400 font-light"
          >Bagikan:</span
        >
        <button
          onclick={`window.open('https://api.whatsapp.com/send?text=' + encodeURIComponent(document.title + ' ' + window.location.href), '_blank')`}
          class="p-2 rounded-full hover:bg-[#a88857]/10 text-neutral-700 transition-colors cursor-pointer"
          title="WhatsApp"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"
            ></path></svg
          >
        </button>
        <button
          onclick={`window.open('https://twitter.com/intent/tweet?text=' + encodeURIComponent(document.title) + '&url=' + encodeURIComponent(window.location.href), '_blank')`}
          class="p-2 rounded-full hover:bg-[#a88857]/10 text-neutral-700 transition-colors cursor-pointer"
          title="X / Twitter"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"
            ><path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path></svg
          >
        </button>
        <button
          onclick="navigator.clipboard.writeText(window.location.href).then(() => showToast('Tautan artikel berhasil disalin!', 'success'))"
          class="p-2 rounded-full hover:bg-[#a88857]/10 text-neutral-700 transition-colors cursor-pointer"
          title="Salin Tautan"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
            ></path></svg
          >
        </button>
      </div>
      <div>
        <span class="text-xs text-[#a88857] font-medium font-editorial"
          >LUXIMA EDITORIAL ISSUE</span
        >
      </div>
    </div>

    <!-- Article Body with Drop Cap and Pull Quotes -->
    <div
      class="text-neutral-800 font-light text-base sm:text-lg leading-[1.85] space-y-6"
    >
      <p class="editorial-dropcap">{firstParagraph}</p>

      {
        remainingParagraphs.map((para, idx) => (
          <>
            {idx === 1 && (
              <blockquote class="editorial-pullquote">
                “Seni pernikahan sejati memadukan ketenangan jiwa dan kemegahan
                rasa dalam harmoni abadi.”
              </blockquote>
            )}
            <p>{para}</p>
          </>
        ))
      }
    </div>

    <!-- Tags -->
    {
      post.tags && post.tags.length > 0 && (
        <div class="mt-12 pt-8 border-t border-[#a88857]/20">
          <span class="text-xs uppercase tracking-wider text-neutral-400 font-light block mb-3">
            Tagar Editorial:
          </span>
          <div class="flex flex-wrap gap-2">
            {post.tags.map((tag: string) => (
              <span class="px-3 py-1 rounded-full text-xs bg-white border border-[#a88857]/30 text-[#87693b] font-light">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )
    }

    <!-- Author Bio Card -->
    <div
      class="mt-14 glass-panel rounded-3xl p-6 sm:p-8 border border-[#a88857]/30 flex flex-col sm:flex-row items-center gap-6"
    >
      <img
        src={authorAvatar}
        alt={authorName}
        onerror="this.onerror=null; this.src='/assets/avatar-fallback.svg';"
        class="w-20 h-20 rounded-full object-cover border-2 border-[#a88857]"
      />
      <div class="text-center sm:text-left">
        <h4 class="font-editorial text-2xl text-[#1A1A1A] font-semibold">
          {authorName}
        </h4>
        <p
          class="text-xs text-[#a88857] uppercase tracking-wider font-light mt-0.5"
        >
          Founder & Editor-in-Chief • LUXIMA
        </p>
        <p class="text-xs text-neutral-600 font-light mt-2 leading-relaxed">
          Mengkurasi kemegahan tradisi sakral, kriya busana kebaya haute
          couture, dan destinasi pernikahan paling memesona di seluruh
          Nusantara.
        </p>
      </div>
    </div>

    <!-- Article Prev/Next Navigation -->
    <div
      class="mt-14 grid grid-cols-1 sm:grid-cols-2 gap-4 border-t border-b border-[#a88857]/20 py-6"
    >
      <a
        href="/"
        class="text-left p-4 rounded-2xl hover:bg-white/60 transition-all border border-transparent hover:border-[#a88857]/30"
      >
        <span
          class="text-[10px] uppercase tracking-widest text-neutral-400 font-light block"
          >Kembali</span
        >
        <span
          class="font-editorial text-base font-semibold text-[#1A1A1A] mt-1 block"
          >← Kembali ke Beranda Majalah</span
        >
      </a>
      <a
        href="/magazine"
        class="text-left sm:text-right p-4 rounded-2xl hover:bg-white/60 transition-all border border-transparent hover:border-[#a88857]/30"
      >
        <span
          class="text-[10px] uppercase tracking-widest text-neutral-400 font-light block"
          >Edisi Cetak</span
        >
        <span
          class="font-editorial text-base font-semibold text-[#1A1A1A] mt-1 block"
          >Jelajahi Edisi Majalah →</span
        >
      </a>
    </div>

    <!-- Related Articles Section -->
    {
      relatedPosts && relatedPosts.length > 0 && (
        <section class="mt-16">
          <div class="mb-8 pb-4 border-b border-[#a88857]/20">
            <span class="text-xs uppercase tracking-[0.2em] text-[#a88857] font-semibold">
              Inspirasi Terkait
            </span>
            <h3 class="font-editorial text-3xl text-[#1A1A1A] font-semibold mt-1">
              Cerita Serupa
            </h3>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedPosts.map((rel) => {
              const relCover = getPostCoverUrl(rel.cover_image, { width: 600, quality: 75 });
              const relSanctuary = getPostSanctuaryDetails(rel);
              return (
                <a
                  href={`/blog/${rel.slug}`}
                  class="glass-card rounded-2xl overflow-hidden group bg-white border border-[#a88857]/20 hover:border-[#a88857]/50 hover:shadow-xl transition-all duration-500"
                >
                  <div class="aspect-[16/10] overflow-hidden relative">
                    <img
                      src={relCover}
                      alt={rel.title}
                      loading="lazy"
                      decoding="async"
                      onerror="this.onerror=null; this.src='https://r2.luxima.id/cdn-cgi/image/width=800,quality=75,format=auto/images/hero/aceh-venue.jpg';"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                    />
                    <div class="absolute top-2.5 left-2.5 bg-black/60 backdrop-blur-md px-2.5 py-0.5 rounded-full text-[8px] uppercase tracking-widest text-[#d8c2a7] font-semibold">
                      {relSanctuary.tag}
                    </div>
                  </div>
                  <div class="p-5">
                    <span class="text-[9px] uppercase tracking-wider text-[#a88857] font-semibold block mb-1">
                      {relSanctuary.sanctuary}
                    </span>
                    <h4 class="font-editorial text-lg font-semibold text-[#1A1A1A] group-hover:text-[#a88857] transition-colors line-clamp-2 leading-snug">
                      {rel.title}
                    </h4>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    <!-- Interactive Comments / Guestbook Section -->
    <section class="mt-16">
      <div
        class="flex items-center justify-between mb-8 pb-4 border-b border-[#a88857]/20"
      >
        <div>
          <span
            class="text-xs uppercase tracking-[0.2em] text-[#a88857] font-semibold"
            >Tanggapan Pembaca</span
          >
          <h3 class="font-editorial text-3xl text-[#1A1A1A] font-semibold">
            Komentar & Ucapan
          </h3>
        </div>
        <span class="text-xs text-neutral-400 font-light"
          >{comments ? comments.length : 0} Tanggapan</span
        >
      </div>

      <!-- Add Comment Form -->
      <div class="glass-panel rounded-2xl p-6 border border-[#a88857]/20 mb-10">
        <h4
          class="text-xs uppercase tracking-wider text-[#87693b] font-semibold mb-4"
        >
          Tinggalkan Ucapan atau Ulasan
        </h4>
        <form id="comment-form" class="space-y-4">
          <input type="hidden" id="comment-post-id" value={post.id} />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <input
              type="text"
              id="comment-author-name"
              required
              placeholder="Nama Anda..."
              class="w-full bg-white border border-[#a88857]/30 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-[#a88857]"
            />
            <input
              type="email"
              id="comment-author-email"
              placeholder="Email (opsional)..."
              class="w-full bg-white border border-[#a88857]/30 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-[#a88857]"
            />
          </div>
          <textarea
            id="comment-content"
            required
            rows="3"
            placeholder="Tuliskan apresiasi, pertanyaan, atau kesan Anda mengenai artikel ini..."
            class="w-full bg-white border border-[#a88857]/30 rounded-xl px-4 py-2.5 text-xs focus:outline-none focus:border-[#a88857]"
          ></textarea>
          <div class="text-right">
            <button
              type="submit"
              class="px-6 py-2.5 rounded-full bg-[#1A1A1A] text-white text-xs uppercase tracking-wider font-semibold hover:bg-[#a88857] transition-all btn-luxury cursor-pointer"
            >
              Kirim Tanggapan
            </button>
          </div>
        </form>
      </div>

      <!-- Comments List -->
      <div id="comments-list" class="space-y-4">
        {
          comments && comments.length > 0 ? (
            comments.map((c) => {
              const commentAvatar = getUserAvatarUrl(c.user?.avatar);
              const commenterName =
                c.user?.fullName || c.author_name || "Pembaca";
              return (
                <div class="glass-card rounded-xl p-4 flex gap-3.5 items-start bg-white border border-[#a88857]/20">
                  <img
                    src={commentAvatar}
                    alt={commenterName}
                    onerror="this.onerror=null; this.src='/assets/avatar-fallback.svg';"
                    class="w-8 h-8 rounded-full object-cover border border-[#a88857]/40 shrink-0 shadow-xs"
                  />
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="text-xs font-semibold text-[#1A1A1A]">
                        {commenterName}
                      </span>
                      <span class="text-[10px] text-neutral-400">
                        • {new Date(c.created_at).toLocaleDateString("id-ID")}
                      </span>
                    </div>
                    <p class="text-xs text-neutral-600 font-light mt-1 leading-relaxed">
                      {c.content}
                    </p>
                  </div>
                </div>
              );
            })
          ) : (
            <p class="text-xs text-neutral-400 text-center py-6">
              Belum ada komentar untuk artikel ini. Jadilah yang pertama
              memberikan ulasan.
            </p>
          )
        }
      </div>
    </section>
  </article>

  <!-- Client-side Comment Submission Handler -->
  <script is:inline>
    document
      .getElementById("comment-form")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const postId = document.getElementById("comment-post-id").value;
        const authorName = document
          .getElementById("comment-author-name")
          .value.trim();
        const authorEmail = document
          .getElementById("comment-author-email")
          .value.trim();
        const content = document.getElementById("comment-content").value.trim();

        if (!postId || !authorName || !content) {
          window.showToast("Harap lengkapi nama dan isi tanggapan.", "error");
          return;
        }

        try {
          const res = await fetch("/api/comments", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              post_id: postId,
              author_name: authorName,
              author_email: authorEmail,
              content,
            }),
          });
          const json = await res.json();
          if (json.success) {
            window.showToast("Tanggapan Anda berhasil dikirimkan!", "success");
            setTimeout(() => window.location.reload(), 600);
          } else {
            window.showToast(
              json.message || "Gagal mengirim tanggapan.",
              "error",
            );
          }
        } catch (err) {
          window.showToast("Koneksi ke server gagal.", "error");
        }
      });
  </script>
</Layout>
