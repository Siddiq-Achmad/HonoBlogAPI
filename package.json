{
  "name": "hono-blog-api",
  "version": "1.0.0",
  "description": "A production-ready Blog REST API built with Hono and Supabase",
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=.env astro dev",
    "build": "bun astro build",
    "start": "bun ./dist/server/entry.mjs",
    "seed": "bun --env-file=.env src/seed.ts",
    "test": "bun test",
    "preview": "bun --env-file=.env astro preview",
    "api": "bun --env-file=.env src/index.ts",
    "server": "bun --env-file=.env src/index.ts"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@hono/zod-validator": "^0.5.0",
    "@supabase/supabase-js": "^2.49.0",
    "astro": "^7.3.1",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "hono": "^4.7.0",
    "hono-rate-limiter": "^0.5.3",
    "ioredis": "^5.10.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "wouter": "^3.10.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.23.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "bun-types": "^1.3.13",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
